# 音视频转图文 · 篝火出品（基于 hanshuaikang/AI-Media2Doc）
# 复制为 .env 后填写，所有带"必填"的项都不能空。.env 里是你的密钥，不要提交到公开仓库。

# ---- 大模型（必填，接口兼容 OpenAI 格式即可，地址 / 密钥 / 模型名都由你自己填）----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
MODEL_ID=

# ---- 对象存储（必填，需要兼容 S3 协议，且能被公网访问）----
# 浏览器把音频传到这里，语音识别服务再从这里下载。上游的示例和教程用的是火山引擎 TOS。
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- 语音识别（必填，上游固定使用火山引擎"录音文件识别"，没有别的选项）----
AUC_APP_ID=
AUC_ACCESS_TOKEN=
AUC_CLUSTER_ID=

# ---- 访问密码（选填）：设置后，网页"自定义设置 → 访问密码"里填同样的密码才能使用；不需要就留空 ----
WEB_ACCESS_PASSWORD=
